{
  "manifest_version": 3,
  "name": "web-issuer",
  "description": "Point at what should change on a page and file one GitHub issue.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "web-issuer"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "identity",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://issuer.pnetto.store/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "key": ""
}
