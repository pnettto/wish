{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "web-issuer",
	"main": "src/index.ts",
	"compatibility_date": "2025-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "issuer.pnetto.store",
			"custom_domain": true
		}
	],
	"vars": {
		// Filled in after the GitHub App is created (docs/github-app-setup.md).
		"GITHUB_CLIENT_ID": "Iv23lix1yEP0yfaykDNp",
		"GITHUB_APP_ID": "5885708",
		"ALLOWED_LOGIN": "pnettto",
		// From `npm run extension-id` (README).
		"EXTENSION_ID": "ndghjkhgmanjhlfhahcbbmpfofdmldbc",
		"TRACKED_REPOS": "pnettto/hawk",
		"PUBLIC_URL": "https://issuer.pnetto.store"
	},
	// Secrets (wrangler secret put / .dev.vars): GITHUB_CLIENT_SECRET,
	// GITHUB_WEBHOOK_SECRET, TOKEN_ENC_KEY.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "web-issuer",
			// Replace with the id printed by `wrangler d1 create web-issuer`.
			"database_id": "77433aae-2eed-4196-b939-88aefb1b6901",
			"migrations_dir": "migrations"
		},
		{
			"binding": "web_issuer",
			"database_name": "web-issuer",
			"database_id": "77433aae-2eed-4196-b939-88aefb1b6901",
			"remote": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "REQUEST_LIVE",
				"class_name": "RequestLive"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RequestLive"
			]
		}
	]
}