{
  "name": "@web-issuer/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply web-issuer --local",
    "db:migrate:remote": "wrangler d1 migrations apply web-issuer --remote",
    "db:seed:local": "wrangler d1 execute web-issuer --local --file test/seed.sql"
  },
  "dependencies": {
    "@web-issuer/shared": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251123.0",
    "wrangler": "^4.50.0"
  }
}
